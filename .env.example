# ============================================================
# Variables de entorno (copia a .env y rellena)
# OJO: todo lo que empiece por VITE_ acaba en el bundle público.
# Nunca pongas aquí una service_role / secret key de IA.
# ============================================================

# --- Supabase (público, protegido por RLS) ---
# Dashboard: Project Settings -> API Keys -> Project URL / Publishable key (anon)
VITE_SUPABASE_URL=https://zrfmltqfunizhudkekdc.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- IA ---
# Groq se llama a través de la Edge Function `ai-proxy` (supabase/functions/ai-proxy).
# La API key es un secreto del proyecto (SUPABASE > Edge Functions > Secrets), NO una VITE_*.
# Para configurarla:  supabase secrets set GROQ_API_KEY=gsk_...
VITE_AI_PROVIDER=groq
# false = asistente en pausa (aviso en el panel y 503 en ai-proxy con AI_ENABLED=false)
VITE_AI_ENABLED=false

# Tienda de consultas (Paddle). Si vale "false" o no está, la web NO muestra nada
# de comprar: no se anuncia lo que no se puede cobrar.
# El precio y los créditos NO se configuran aquí: viven en el secreto
# PADDLE_CATALOG de las Edge Functions (supabase/functions/_shared/paddle.ts).
VITE_PAYMENTS_ENABLED=false

# Token de cliente de Paddle (PÚBLICO, puede ir en el bundle): My account >
# Settings > Authentication > Client-side tokens. En sandbox empieza por test_.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
