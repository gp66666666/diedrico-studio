# ============================================================
# Variables de entorno (copia a .env y rellena)
# OJO: todo lo que empiece por VITE_ acaba en el bundle público.
# Nunca pongas aquí una service_role / secret key de IA.
# ============================================================

# --- Supabase (público, protegido por RLS) ---
# Dashboard: Project Settings -> API Keys -> Project URL / Publishable key (anon)
VITE_SUPABASE_URL=https://zrfmltqfunizhudkekdc.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- IA ---
# Groq se llama a través de la Edge Function `ai-proxy` (supabase/functions/ai-proxy).
# La API key es un secreto del proyecto (SUPABASE > Edge Functions > Secrets), NO una VITE_*.
# Para configurarla:  supabase secrets set GROQ_API_KEY=gsk_...
VITE_AI_PROVIDER=groq
VITE_ENABLE_AI=true
